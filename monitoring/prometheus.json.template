{
  "global": {"scrape_interval": "2s", "scrape_timeout": "1s", "evaluation_interval": "1s"},
  "rule_files": ["/config/alerts.yml"],
  "alerting": {"alertmanagers": [{"static_configs": [{"targets": ["$ALERTMANAGER_HOST:9093"]}]}]},
  "scrape_configs": [
    {
      "job_name": "inventory-app",
      "metrics_path": "/actuator/prometheus",
      "follow_redirects": false,
      "basic_auth": {"username": "admin", "password_file": "/config/metrics-password"},
      "static_configs": [{"targets": ["$APP_HOST:8080"], "labels": {"drill_run": "$RUN_ID"}}]
    },
    {
      "job_name": "inventory-readiness",
      "scrape_interval": "10s",
      "scrape_timeout": "9s",
      "metrics_path": "/probe",
      "params": {"module": ["inventory_readiness"]},
      "static_configs": [{"targets": ["http://$APP_HOST:8080/actuator/health/readiness"], "labels": {"drill_run": "$RUN_ID"}}],
      "relabel_configs": [
        {"source_labels": ["__address__"], "target_label": "__param_target"},
        {"source_labels": ["__param_target"], "target_label": "instance"},
        {"target_label": "__address__", "replacement": "$BLACKBOX_HOST:9115"}
      ]
    }
  ]
}
