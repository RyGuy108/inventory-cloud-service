# Local development only. Copy to .env, replace all four passwords, and never commit .env.
DATABASE_PASSWORD=replace-with-a-long-local-database-password
DATABASE_APP_PASSWORD=replace-with-a-different-long-runtime-password
APP_AUTH_ADMIN_PASSWORD=replace-with-a-long-local-admin-password
APP_AUTH_CUSTOMER_PASSWORD=replace-with-a-long-local-customer-password
